# ═══════════════════════════════════════════════════════════════
# FedMedShield — Environment Configuration Template
# Copy this file to .env and configure for your local environment
# ═══════════════════════════════════════════════════════════════

# Security & JWT Authentication
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fedmedshield

# MongoDB Configuration (Async via Motor)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fedmedshield_audit

# Redis Configuration (PubSub & WebSocket Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173

# Federated Learning Engine Settings
FL_SERVER_ADDRESS=0.0.0.0:8080
FL_NUM_ROUNDS=10
FL_MIN_CLIENTS=2
FL_ROUND_TIMEOUT=300

# Differential Privacy Calibration Defaults
DP_DEFAULT_EPSILON=5.0
DP_DEFAULT_DELTA=1e-5
DP_CLIP_NORM=1.0
DP_NOISE_MULTIPLIER=1.0
